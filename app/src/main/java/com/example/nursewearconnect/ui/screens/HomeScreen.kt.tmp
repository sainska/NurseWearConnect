@Composable
fun AdminPendingTasks(
    pendingVendors: List<Map<String, Any>>,
    lowStockProducts: List<Product>,
    pendingBanners: List<Map<String, Any>> = emptyList(),
    onApproveVendor: (String) -> Unit,
    onApproveBanner: (String) -> Unit = {},
    onNavigateToInventory: () -> Unit
) {
    Column(
        modifier = Modifier
            .fillMaxWidth()
            .padding(horizontal = 24.dp),
        verticalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        // Pending Banner Approvals
        pendingBanners.take(3).forEach { banner ->
            val title = banner["title"] as? String ?: "New Banner"
            val bannerId = banner["id"] as? String ?: ""
            val vendorName = banner["vendor_name"] as? String ?: "Vendor"
            
            Surface(
                modifier = Modifier.fillMaxWidth(),
                shape = RoundedCornerShape(16.dp),
                color = Success50,
                border = BorderStroke(1.dp, Color(0xFFBBF7D0))
            ) {
                Row(
                    modifier = Modifier.padding(16.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Box(
                        modifier = Modifier
                            .size(40.dp)
                            .background(Color(0xFFDCFCE7), CircleShape),
                        contentAlignment = Alignment.Center
                    ) {
                        Icon(Icons.Default.Campaign, contentDescription = null, tint = Success600)
                    }
                    Spacer(Modifier.width(16.dp))
                    Column(modifier = Modifier.weight(1f)) {
                        Text("Banner Request", fontSize = 14.sp, fontWeight = FontWeight.Bold, color = Color(0xFF166534))
                        Text("$title by $vendorName", fontSize = 12.sp, color = Success600)
                    }
                    TextButton(onClick = { onApproveBanner(bannerId) }) {
                        Text("Approve", color = Success600, fontWeight = FontWeight.Bold)
                    }
                }
            }
        }

        // Pending Vendor Approvals
        pendingVendors.take(3).forEach { vendor ->
            val vendorName = vendor["full_name"] as? String ?: "New Vendor"
            val vendorId = vendor["id"] as? String ?: ""
            val avatarUrl = vendor["avatar_url"] as? String
            
            Surface(
                modifier = Modifier.fillMaxWidth(),
                shape = RoundedCornerShape(16.dp),
                color = Color(0xFFFFFBEB),
                border = BorderStroke(1.dp, Color(0xFFFDE68A))
            ) {
                Row(
                    modifier = Modifier.padding(16.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Box(
                        modifier = Modifier
                            .size(40.dp)
                            .background(Color(0xFFFEF3C7), CircleShape),
                        contentAlignment = Alignment.Center
                    ) {
                        if (!avatarUrl.isNullOrEmpty()) {
                            AsyncImage(
                                model = avatarUrl,
                                contentDescription = null,
                                modifier = Modifier.fillMaxSize().clip(CircleShape),
                                contentScale = ContentScale.Crop
                            )
                        } else {
                            Icon(Icons.Default.Store, contentDescription = null, tint = Color(0xFFB45309))
                        }
                    }
                    Spacer(Modifier.width(16.dp))
                    Column(modifier = Modifier.weight(1f)) {
                        Text("Vendor Approval", fontSize = 14.sp, fontWeight = FontWeight.Bold, color = Color(0xFF92400E))
                        Text(vendorName, fontSize = 12.sp, color = Color(0xFFB45309))
                    }
                    TextButton(onClick = { onApproveVendor(vendorId) }) {
                        Text("Approve", color = Color(0xFFB45309), fontWeight = FontWeight.Bold)
                    }
                }
            }
        }

        // Low Stock Alerts
        lowStockProducts.take(3).forEach { product ->
            Surface(
                modifier = Modifier.fillMaxWidth(),
                shape = RoundedCornerShape(16.dp),
                color = Color(0xFFFEF2F2),
                border = BorderStroke(1.dp, Color(0xFFFECACA))
            ) {
                Row(
                    modifier = Modifier.padding(16.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Box(
                        modifier = Modifier
                            .size(40.dp)
                            .background(Color(0xFFFEE2E2), CircleShape),
                        contentAlignment = Alignment.Center
                    ) {
                        Icon(Icons.Default.Warning, contentDescription = null, tint = Color(0xFFB91C1C))
                    }
                    Spacer(Modifier.width(16.dp))
                    Column(modifier = Modifier.weight(1f)) {
                        Text("Low Stock Alert", fontSize = 14.sp, fontWeight = FontWeight.Bold, color = Color(0xFF991B1B))
                        Text("${product.name} (${product.stockCount} left)", fontSize = 12.sp, color = Color(0xFFB91C1C))
                    }
                    IconButton(onClick = onNavigateToInventory) {
                        Icon(Icons.Default.ChevronRight, contentDescription = null, tint = Color(0xFFB91C1C))
                    }
                }
            }
        }
        
        if (pendingVendors.isEmpty() && lowStockProducts.isEmpty() && pendingBanners.isEmpty()) {
            Surface(
                modifier = Modifier.fillMaxWidth(),
                shape = RoundedCornerShape(16.dp),
                color = Slate50,
                border = BorderStroke(1.dp, Slate100)
            ) {
                Text(
                    "All caught up! No pending tasks.",
                    modifier = Modifier.padding(24.dp),
                    textAlign = TextAlign.Center,
                    color = Slate500,
                    fontSize = 14.sp
                )
            }
        }
        // SnackBar for success messages
        uiState.successMessage?.let { message ->
            LaunchedEffect(message) {
                // Clear success message after showing
                delay(3000)
                viewModel.clearSuccessMessage()
            }
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(top = 16.dp, start = 16.dp, end = 16.dp)
                    .align(Alignment.TopCenter)
                    .zIndex(1f)
            ) {
                Surface(
                    color = Color(0xFF065F46),
                    contentColor = Color.White,
                    shape = RoundedCornerShape(12.dp),
                    shadowElevation = 4.dp
                ) {
                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(horizontal = 16.dp, vertical = 12.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Icon(Icons.Default.CheckCircle, null, tint = Color.White)
                        Spacer(Modifier.width(12.dp))
                        Text(message, fontSize = 14.sp, fontWeight = FontWeight.Medium)
                    }
                }
            }
        }
    }
}

@Composable
fun AdminActivityList(
    logs: List<Map<String, Any>> = emptyList(),
    onSeeAllOrders: () -> Unit = {}
) {
    Column(
        modifier = Modifier
            .fillMaxWidth()
            .padding(horizontal = 24.dp),
        verticalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        if (logs.isEmpty()) {
            Surface(
                modifier = Modifier.fillMaxWidth(),
                shape = RoundedCornerShape(16.dp),
                color = Color.White.copy(alpha = 0.5f),
                border = BorderStroke(1.dp, Slate100)
            ) {
                Column(
                    modifier = Modifier.padding(24.dp),
                    horizontalAlignment = Alignment.CenterHorizontally
                ) {
                    Icon(Icons.Default.History, null, tint = Slate300, modifier = Modifier.size(32.dp))
                    Spacer(Modifier.height(8.dp))
                    Text("No recent activity found", color = Slate500, fontSize = 14.sp)
                }
            }
        } else {
            logs.take(5).forEach { log ->
                val action = log["action"] as? String ?: "System Action"
                val details = log["details"] as? String ?: ""
                
                Surface(
                    modifier = Modifier.fillMaxWidth(),
                    shape = RoundedCornerShape(16.dp),
                    color = Color.White,
                    border = BorderStroke(1.dp, Slate100)
                ) {

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun SizeQuizBottomSheet(
    onDismiss: () -> Unit,
    onComplete: (String) -> Unit,
    gender: String = "Unisex"
) {
    var step by remember { mutableStateOf(1) }
    var height by remember { mutableStateOf("") }
    var weight by remember { mutableStateOf("") }
    var fitPreference by remember { mutableStateOf("Regular") }
    var chestCircumference by remember { mutableStateOf("") }

    ModalBottomSheet(
        onDismissRequest = onDismiss,
        containerColor = Color.White,
        dragHandle = { BottomSheetDefaults.DragHandle() }
    ) {
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .padding(24.dp)
                .padding(bottom = 32.dp),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            Text(
                text = "Step $step of ${if (gender == "Female") 4 else 3}",
                style = MaterialTheme.typography.labelMedium,
                color = Brand600
            )
            
            Spacer(Modifier.height(8.dp))
            
            LinearProgressIndicator(
                progress = { step / (if (gender == "Female") 4f else 3f) },
                modifier = Modifier.fillMaxWidth().height(4.dp),
                color = Brand600,
                trackColor = Brand100
            )
            
            Spacer(Modifier.height(24.dp))
            
            when (step) {
                1 -> {
                    Text("What is your height?", style = MaterialTheme.typography.titleLarge, fontWeight = FontWeight.Bold)
                    Text("Helps us determine the length of your scrubs", fontSize = 14.sp, color = Slate500)
                    Spacer(Modifier.height(24.dp))
                    OutlinedTextField(
                        value = height,
                        onValueChange = { height = it },
                        label = { Text("Height (cm)") },
                        placeholder = { Text("e.g. 175") },
                        modifier = Modifier.fillMaxWidth(),
                        shape = RoundedCornerShape(12.dp),
                        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number)
                    )
                }
                2 -> {
                    Text("What is your weight?", style = MaterialTheme.typography.titleLarge, fontWeight = FontWeight.Bold)
                    Text("Weight helps us estimate your body volume", fontSize = 14.sp, color = Slate500)
                    Spacer(Modifier.height(24.dp))
                    OutlinedTextField(
                        value = weight,
                        onValueChange = { weight = it },
                        label = { Text("Weight (kg)") },
                        placeholder = { Text("e.g. 70") },
                        modifier = Modifier.fillMaxWidth(),
                        shape = RoundedCornerShape(12.dp),
                        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number)
                    )
                }
                3 -> {
                    if (gender == "Female") {
                        Text("Chest/Bust measurement?", style = MaterialTheme.typography.titleLarge, fontWeight = FontWeight.Bold)
                        Text("Crucial for a comfortable fit in feminine cuts", fontSize = 14.sp, color = Slate500)
                        Spacer(Modifier.height(24.dp))
                        OutlinedTextField(
                            value = chestCircumference,
                            onValueChange = { chestCircumference = it },
                            label = { Text("Chest (cm)") },
                            placeholder = { Text("e.g. 90") },
                            modifier = Modifier.fillMaxWidth(),
                            shape = RoundedCornerShape(12.dp),
                            keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number)
                        )
                    } else {
                        FitPreferenceStep(fitPreference) { fitPreference = it }
                    }
                }
                4 -> {
                    FitPreferenceStep(fitPreference) { fitPreference = it }
                }
            }
            
            Spacer(Modifier.height(32.dp))
            
            val isNextEnabled = when(step) {
                1 -> height.isNotEmpty()
                2 -> weight.isNotEmpty()
                3 -> if (gender == "Female") chestCircumference.isNotEmpty() else true
                else -> true
            }

            Button(
                onClick = {
                    val maxSteps = if (gender == "Female") 4 else 3
                    if (step < maxSteps) {
                        step++
                    } else {
                        // AI-Based Recommendation Logic (Enterprise Implementation)
                        val h = height.toIntOrNull() ?: 170
                        val w = weight.toIntOrNull() ?: 70
                        val bmi = w / ((h / 100f) * (h / 100f))
                        
                        val recommendedSize = when {
                            bmi < 18.5 -> "XS"
                            bmi < 22 -> "S"
                            bmi < 26 -> "M"
                            bmi < 30 -> "L"
                            bmi < 35 -> "XL"
                            else -> "XXL"
                        }
                        
                        // Adjust for fit preference
                        val finalSize = if (fitPreference == "Slim") {
                            // Suggest one size down if not XS
                            if (recommendedSize == "S") "XS" else recommendedSize
                        } else if (fitPreference == "Loose") {
                            // Suggest one size up if not XXL
                            if (recommendedSize == "L") "XL" else recommendedSize
                        } else recommendedSize

                        onComplete(finalSize)
                    }
                },
                enabled = isNextEnabled,
                modifier = Modifier.fillMaxWidth(),
                shape = RoundedCornerShape(12.dp),
                colors = ButtonDefaults.buttonColors(containerColor = Brand600)
            ) {
                val maxSteps = if (gender == "Female") 4 else 3
                Text(if (step < maxSteps) "Next" else "Find My Size")
            }
        }
        // SnackBar for success messages
        uiState.successMessage?.let { message ->
            LaunchedEffect(message) {
                // Clear success message after showing
                delay(3000)
                viewModel.clearSuccessMessage()
            }
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(top = 16.dp, start = 16.dp, end = 16.dp)
                    .align(Alignment.TopCenter)
                    .zIndex(1f)
            ) {
                Surface(
                    color = Color(0xFF065F46),
                    contentColor = Color.White,
                    shape = RoundedCornerShape(12.dp),
                    shadowElevation = 4.dp
                ) {
                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(horizontal = 16.dp, vertical = 12.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Icon(Icons.Default.CheckCircle, null, tint = Color.White)
                        Spacer(Modifier.width(12.dp))
                        Text(message, fontSize = 14.sp, fontWeight = FontWeight.Medium)
                    }
                }
            }
        }
    }
}

@Composable
private fun FitPreferenceStep(selected: String, onSelect: (String) -> Unit) {
    Text("Preferred Fit?", style = MaterialTheme.typography.titleLarge, fontWeight = FontWeight.Bold)
    Text("How do you like your scrubs to feel?", fontSize = 14.sp, color = Slate500)
    Spacer(Modifier.height(24.dp))
    Row(
        Modifier.fillMaxWidth(),
        horizontalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        listOf("Slim", "Regular", "Loose").forEach { fit ->
            val isSelected = selected == fit
            Surface(
                onClick = { onSelect(fit) },
                modifier = Modifier.weight(1f),
                shape = RoundedCornerShape(12.dp),
                color = if (isSelected) Brand600 else Slate50,
                border = BorderStroke(1.dp, if (isSelected) Brand600 else Slate200)
            ) {
                Box(
                    modifier = Modifier.padding(vertical = 16.dp),
                    contentAlignment = Alignment.Center
                ) {
                    Text(
                        fit,
                        fontWeight = FontWeight.Bold,
                        color = if (isSelected) Color.White else Slate700
                    )
